rules_version = '2';

// Every document belongs to exactly one user (ownerId). Users can only see and change their own.
// Note: rules are not filters, so client queries must include whereEqualTo("ownerId", uid).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function ownsIncoming() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Radius bounds: the app offers 10-200 m. A huge fence would make its files openable anywhere.
    function validNewArea() {
      let radius = request.resource.data.radius;
      return radius is number && radius > 0 && radius <= 1000
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;
    }

    function ownsArea(areaId) {
      let path = /databases/$(database)/documents/geofence_areas/$(areaId);
      return exists(path) && get(path).data.ownerId == request.auth.uid;
    }

    match /geofence_areas/{areaId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming() && validNewArea();
      // A fence can be renamed but never moved, resized or given away: moving a fence to
      // wherever you're standing would unlock its files.
      allow update: if ownsExisting()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
    }

    match /geofences/{geofenceId}/entities/{entityId} {
      allow read, delete: if ownsExisting();
      // Files can only be attached to a geofence the caller owns.
      allow create: if ownsIncoming() && ownsArea(geofenceId);
      // No updates: the app never edits a file record, so nobody else should either.
    }

    // Everything else is denied by default.
  }
}
